<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mx.uam.ayd.proyecto.presentacion.pedidoDomicilio.VentanaConsultaPedidos"
      spacing="16"
      prefWidth="650"
      prefHeight="450"
      style="-fx-background-color: #F4F6F9;">

    <padding>
        <Insets top="24" right="28" bottom="24" left="28"/>
    </padding>

    <VBox spacing="5">
        <Label text="Consulta de Pedidos a Domicilio"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #243447;"/>
        <Label text="Monitorea los pedidos en ruta y marca su entrega para cerrar la venta."
               style="-fx-font-size: 13px; -fx-text-fill: #65758B;"/>
    </VBox>

    <Separator/>

    <!-- Tabla de Pedidos -->
    <TableView fx:id="tablaPedidos" prefHeight="280" prefWidth="600">
        <columns>
            <TableColumn fx:id="colIdPedido" text="ID Pedido" prefWidth="110"/>
            <TableColumn fx:id="colRepartidor" text="Repartidor" prefWidth="150"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="140"/>
            <TableColumn fx:id="colTotal" text="Total Final" prefWidth="140"/>
        </columns>
    </TableView>

    <!-- Botón de acción -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="btnMarcarEntregado"
                text="Marcar como Entregado"
                onAction="#handleMarcarEntregado"
                style="-fx-background-color: #2471A3; -fx-text-fill: white; -fx-font-weight: bold;"
                />
    </HBox>

</VBox>