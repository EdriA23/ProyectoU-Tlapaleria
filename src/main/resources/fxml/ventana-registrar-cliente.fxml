<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="480.0" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
   </padding>
   <children>
      <Label text="Registrar Cliente (HU-12)" textFill="#1a365d">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Label text="Registre al cliente para asignarle el descuento de fidelidad (5%). Los campos con * son obligatorios." textFill="#666666" wrapText="true">
         <font>
            <Font size="12.0" />
         </font>
      </Label>

      <VBox spacing="12.0">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label text="Nombre completo *">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtNombre" promptText="Ej. María Rodríguez López" />
               </children>
            </VBox>

            <VBox spacing="4.0">
               <children>
                  <Label text="Teléfono *">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtTelefono" promptText="Ej. 5551234567" />
               </children>
            </VBox>

            <VBox spacing="4.0">
               <children>
                  <Label text="Correo electrónico">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtCorreo" promptText="Ej. cliente@correo.com" />
               </children>
            </VBox>

            <VBox spacing="4.0">
               <children>
                  <Label text="Dirección (opcional)">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtDireccion" promptText="Calle, número, colonia..." />
               </children>
            </VBox>
         </children>
      </VBox>

      <HBox alignment="CENTER_RIGHT" spacing="12.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleBuscarClientes" text="🔍 Buscar Clientes" />
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleCancelar" text="Cancelar" />
            <Button mnemonicParsing="false" onAction="#handleGuardar" style="-fx-background-color: #2b6cb0;" text="Guardar Cliente" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
         </children>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>
