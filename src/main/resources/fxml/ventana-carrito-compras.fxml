<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="580.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uam.ayd.proyecto.presentacion.registroVenta.VentanaCarrito">
   <children>
      <!-- Título de la Ventana -->
      <Label layoutX="25.0" layoutY="15.0" text="Confirmación de Venta - Resumen del Carrito" textFill="#2c3e50">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>

      <!-- Tabla de Ventas -->
      <TableView fx:id="tablaCarrito" layoutX="25.0" layoutY="55.0" prefHeight="210.0" prefWidth="700.0">
         <columns>
            <TableColumn fx:id="colNombre" prefWidth="300.0" text="Descripción del Producto" />
            <TableColumn fx:id="colPrecio" prefWidth="120.0" text="Precio Unitario" />
            <TableColumn fx:id="colCantidad" prefWidth="100.0" text="Cantidad" />
            <TableColumn fx:id="colSubtotal" prefWidth="175.0" text="Subtotal" />
         </columns>
      </TableView>

      <!-- Sección del Cliente y Selección de Tarjeta -->
      <Label fx:id="lblClienteInfo" layoutX="25.0" layoutY="280.0" text="Cliente: No seleccionado" textFill="#34495e">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>

      <Label layoutX="25.0" layoutY="310.0" text="Seleccionar Tarjeta para Pago:" textFill="#7f8c8d">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>

      <!-- Checklist / Lista de Tarjetas del Cliente -->
      <ListView fx:id="listTarjetas" layoutX="25.0" layoutY="330.0" prefHeight="130.0" prefWidth="530.0" />

      <!-- Botón para Registrar Nuevas Tarjetas -->
      <Button fx:id="btnAgregarTarjeta" layoutX="570.0" layoutY="330.0" mnemonicParsing="false" onAction="#onAgregarTarjeta" prefHeight="35.0" prefWidth="155.0" style="-fx-background-color: #8e44ad;" text="+ Agregar Tarjeta" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>

      <!-- Sección de Totales -->
      <Label layoutX="460.0" layoutY="485.0" text="TOTAL A COBRAR:">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Label fx:id="lblTotal" layoutX="630.0" layoutY="485.0" text="\$0.00" textFill="#e67e22">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>

      <!-- Botones de Acción -->
      <Button layoutX="560.0" layoutY="525.0" mnemonicParsing="false" onAction="#onConfirmarVenta" prefHeight="35.0" prefWidth="165.0" style="-fx-background-color: #27ae60;" text="Confirmar y Cobrar" textFill="WHITE">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
      
      <Button fx:id="btnPedidoADomicilio" layoutX="250.0" layoutY="525.0" mnemonicParsing="false" onAction="#onPedidoADomicilio" prefHeight="35.0" prefWidth="165.0" style="-fx-background-color: #2980b9;" text="Pedido a Domicilio" textFill="WHITE">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>

      <Button layoutX="120.0" layoutY="525.0" mnemonicParsing="false" onAction="#onCancelarVenta" prefHeight="35.0" prefWidth="110.0" style="-fx-background-color: #e74c3c;" text="Limpiar (RN-12)" textFill="WHITE" />
   </children>
</AnchorPane>