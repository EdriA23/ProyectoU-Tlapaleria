<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="420.0" prefWidth="420.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uam.ayd.proyecto.presentacion.margenGanancia.VentanaEditarMargen">
   <children>
      <!-- Título de la Ventana Emergente -->
      <Label layoutX="25.0" layoutY="20.0" text="Calcular Margen de Ganancia" textFill="#2c3e50">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      
      <!-- Información del Producto Selected -->
      <Label layoutX="25.0" layoutY="65.0" text="PRODUCTO" textFill="#7f8c8d">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <TextField fx:id="txtProducto" editable="false" layoutX="25.0" layoutY="85.0" prefHeight="35.0" prefWidth="370.0" style="-fx-background-color: #f8f9fa; -fx-border-color: #e2e8f0; -fx-border-radius: 4;" />

      <!-- Precio de Costo -->
      <Label layoutX="25.0" layoutY="135.0" text="PRECIO DE COSTO ($)" textFill="#7f8c8d">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <TextField fx:id="txtCosto" layoutX="25.0" layoutY="155.0" prefHeight="35.0" prefWidth="370.0" style="-fx-border-color: #cbd5e1; -fx-border-radius: 4;" />

      <!-- Precio de Venta -->
      <Label layoutX="25.0" layoutY="205.0" text="PRECIO DE VENTA ($)" textFill="#7f8c8d">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <TextField fx:id="txtVenta" layoutX="25.0" layoutY="225.0" prefHeight="35.0" prefWidth="370.0" style="-fx-border-color: #cbd5e1; -fx-border-radius: 4;" />

      <!-- Margen Calculado en Tiempo Real -->
      <Label layoutX="25.0" layoutY="275.0" text="MARGEN CALCULADO (%)" textFill="#7f8c8d">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <TextField fx:id="txtMargen" editable="false" layoutX="25.0" layoutY="295.0" prefHeight="35.0" prefWidth="370.0" style="-fx-background-color: #e8f5e9; -fx-text-fill: #2e7d32; -fx-font-weight: bold; -fx-border-color: #a5d6a7; -fx-border-radius: 4;" />

      <!-- Botones de Acción -->
      <Button layoutX="185.0" layoutY="360.0" mnemonicParsing="false" onAction="#handleCancelar" prefHeight="35.0" prefWidth="95.0" style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 5; -fx-cursor: hand;" text="Cancelar" textFill="#2c3e50">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
      <Button layoutX="290.0" layoutY="360.0" mnemonicParsing="false" onAction="#handleGuardar" prefHeight="35.0" prefWidth="105.0" style="-fx-background-color: #009688; -fx-background-radius: 5; -fx-cursor: hand;" text="Guardar Cambios" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
   </children>
</AnchorPane>