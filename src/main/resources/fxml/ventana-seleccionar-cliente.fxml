<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="480.0" prefWidth="640.0" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
   </padding>
   <children>
      <Label text="Seleccionar Cliente" textFill="#1a365d">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Label text="Busque por nombre, teléfono o número de cliente. Doble clic o el botón Seleccionar para elegirlo." textFill="#666666" wrapText="true">
         <font>
            <Font size="12.0" />
         </font>
      </Label>

      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <TextField fx:id="txtBusqueda" onAction="#handleBuscar" prefHeight="34.0" promptText="Nombre, teléfono o número de cliente" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleBuscar" prefHeight="34.0" prefWidth="100.0" style="-fx-background-color: #2b6cb0;" text="Buscar" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
            <Button mnemonicParsing="false" onAction="#handleMostrarTodos" prefHeight="34.0" prefWidth="120.0" text="Mostrar todos" />
         </children>
      </HBox>

      <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS">
         <placeholder>
            <Label text="No hay clientes para mostrar." />
         </placeholder>
         <columns>
            <TableColumn fx:id="colId" prefWidth="90.0" text="No. Cliente" />
            <TableColumn fx:id="colNombre" prefWidth="260.0" text="Nombre" />
            <TableColumn fx:id="colTelefono" prefWidth="140.0" text="Teléfono" />
            <TableColumn fx:id="colDescuento" prefWidth="90.0" text="Descuento" />
         </columns>
      </TableView>

      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label fx:id="lblResultados" text="0 clientes" textFill="#4a5568" />
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleCancelar" text="Cancelar" />
            <Button mnemonicParsing="false" onAction="#handleSeleccionar" style="-fx-background-color: #2f855a;" text="Seleccionar" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
         </children>
      </HBox>
   </children>
</VBox>
